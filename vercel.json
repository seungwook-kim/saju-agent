{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "saju-agent"
      }
    }
  ],
  "services": {
    "saju-agent": {
      "root": "."
    }
  }
}
