# ============================================================================
# 설정 적는 곳 (예시)
#
# 1) 이 파일을 복사해서 이름을 .env 로 바꾼다 (같은 폴더).
# 2) .env 에 값을 채운다. .env 는 git 에 올라가지 않는다 (.gitignore).
# 3) 서버를 다시 켠다.
#
# 배포(Vercel)에서는 .env 대신 Vercel 대시보드 > Settings > Environment Variables (Production) 에 같은 이름으로 넣는다.
# 비어 있는 값은 안 쓴다는 뜻이다. 비워 두면 지금처럼 로컬 SQLite 로 돈다.
# ============================================================================

# ---- Supabase (공유 링크·AI 풀이 저장) -------------------------------------
# Supabase 대시보드 > Project Settings > API (또는 Data API) 에서 복사한다.
# 주소: Project URL, 예) https://abcdefghijkl.supabase.co
SUPABASE_URL=
# 서버 전용 키: "Secret keys" 의 sb_secret_... (예전 화면이면 service_role 키)
# 이 키는 DB 를 마음대로 읽고 쓸 수 있다. 채팅·코드·스크린샷에 절대 붙이지 말 것.
# anon / publishable 키가 아니다.
SUPABASE_SECRET_KEY=
# 로컬(이 컴퓨터)은 위 키가 있어도 SQLite 에 저장한다 (운영 DB 에 로컬 결과가 섞이지 않게).
# Vercel·HOST=0.0.0.0 서버는 Supabase. 직접 정하려면 SAJU_STORE=supabase 또는 sqlite
# SAJU_STORE=auto

# ---- AI 풀이 (유료) ---------------------------------------------------------
# 비워 두면 AI 없이 계산 풀이만 보여 준다 (요금 0원).
# 운영은 SAJU_AI_BACKEND=anthropic + ANTHROPIC_API_KEY (Claude Haiku 5.5, 2026-10-16). 아래 OpenRouter 는 예전 방식.
# 켜려면 세 줄을 채운다 (AI_BACKEND=openrouter). 모델은 qwen/qwen3.7-flash (2026-09-27 고른 가장 싼 적합 모델)
# 생각 기능은 꺼서 부르고(요금), 같은 모델이면 가장 싼 제공사로 보낸다 (ai.py _openrouter_extra)
SAJU_AI_BACKEND=
OPENROUTER_API_KEY=
SAJU_OPENROUTER_MODEL=
# 한 시간에 부르는 AI 상한 (요금 보호). OpenRouter 기본 600
SAJU_AI_PER_HOUR=

# ---- Claude API (Anthropic, 유료 종량제: Max 구독과 따로 결제됨) ---------------
# SAJU_AI_BACKEND=anthropic 일 때 쓴다. 생각 기능은 끄고 부르고, 챕터 답 상한은 3,000 토큰
ANTHROPIC_API_KEY=
# 기본 claude-haiku-5-5. 다른 모델이면 요금(100만 토큰당 달러, 입력,출력)도 같이: SAJU_ANTHROPIC_PRICE=0.10,0.50
SAJU_ANTHROPIC_MODEL=

# ---- AI 호출 기록 (Langfuse) ------------------------------------------------
# Langfuse 대시보드 > Settings > API Keys 에서 만든 두 키. 비우면 기록하지 않는다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 기본 https://cloud.langfuse.com (EU). 미국 리전 프로젝트면 https://us.cloud.langfuse.com
LANGFUSE_HOST=
# 0 이면 입력·출력 글은 빼고 토큰·비용·시간만 보낸다
SAJU_LANGFUSE_CONTENT=

# ---- 상담 채팅 --------------------------------------------------------------
# auto(기본): 이 컴퓨터에서 접속할 때만 / 1: 어디서나 / 0: 막음
SAJU_CHAT=
# 한 사람당 하루 질문 수. 기본 5 (IP·쿠키·결과·사주 중 하나라도 다 쓰면 막음, 이 컴퓨터에서는 세지 않는다)
SAJU_CHAT_PER_DAY=
# 모두 합쳐 하루 질문 상한. 기본 300
SAJU_CHAT_GLOBAL_PER_DAY=

# ---- 배포(Vercel) ------------------------------------------------------------
# Vercel 에서는 대시보드 > Settings > Environment Variables 에 넣는다. 추천 값:
#   SAJU_AI_BACKEND=anthropic, ANTHROPIC_API_KEY=...,
#   SUPABASE_URL=..., SUPABASE_SECRET_KEY=..., SAJU_TRUST_PROXY=1, SAJU_IP_HEADER=x-real-ip,
#   SAJU_CHAT=0, SAJU_PREFETCH=0, SAJU_AI_PER_HOUR=600
# (VERCEL 값은 Vercel 이 알아서 넣는다: 챕터를 요청 안에서 만들고 임시 파일은 /tmp 에 둔다)
SAJU_TRUST_PROXY=
SAJU_IP_HEADER=

# ---- 배포 주소 --------------------------------------------------------------
# 다른 사이트에서 온 요청은 막는다. 주소가 여러 개(자체 도메인 등)면 쉼표로 적는다. 예) saju.example.com
SAJU_ORIGINS=

# ---- 선택 설정 (코드에 기본값이 있어 보통 안 건드린다. 쓰려면 # 를 지우고 값을 넣는다) ----------
# 예전 이름의 Supabase 서버 키. SUPABASE_SECRET_KEY 가 없을 때만 이 이름을 읽는다
# SUPABASE_SERVICE_ROLE_KEY=
# AI: 끄려면 0 (기본 1)
# SAJU_AI=1
# AI: cli 방식에서 실행할 명령 이름(기본 claude) / 모델(기본 claude-sonnet-5) / 동시에 부르는 수(기본 3) / 답 상한 토큰(기본 anthropic 3000, 그 밖 2000)
# SAJU_AI_CLI=claude
# SAJU_AI_MODEL=
# SAJU_AI_PARALLEL=3
# SAJU_AI_MAX_TOKENS=
# 요금 계산용 100만 토큰당 달러 "입력,출력" (기본 0.10,0.50), 호출 주소
# SAJU_ANTHROPIC_PRICE=0.10,0.50
# SAJU_ANTHROPIC_URL=https://api.anthropic.com/v1/messages
# SAJU_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# OpenRouter: 생각 기능 on/off(기본 off), 제공사 정렬(기본 price), 요청에 붙는 앱 이름
# SAJU_OPENROUTER_REASONING=off
# SAJU_OPENROUTER_SORT=price
# SAJU_APP_NAME=saju-agent
# 다른 사람이 접속하는 서버면 1 (구독 CLI 방식 AI 를 막는다. --host 0.0.0.0 이면 자동)
# SAJU_PUBLIC=1
# 사용자 지정 LLM 허용(기본 0)
# SAJU_CUSTOM_LLM=0
# 저장 위치: 풀이 DB 파일(기본 data/fortune.db, Vercel 은 /tmp) / 콘텐츠 DB 파일
# SAJU_DB=
# SAJU_CONTENT_DB=
# 끄는 스위치 (기본 켜짐, 0 이면 끔): 봇 차단 / 오래된 기록 정리 / 요청 횟수 제한 / 챕터 미리 만들기
# SAJU_BOT_BLOCK=1
# SAJU_PURGE=1
# SAJU_RATE=1
# SAJU_PREFETCH=1
# 프록시 뒤에 있을 때 믿을 프록시 단계 수(기본 1)
# SAJU_PROXY_HOPS=1
# .env 파일 읽기를 끄려면 0
# SAJU_DOTENV=1
# 서버를 켤 때 브라우저 자동으로 열기 (1)
# SAJU_OPEN_BROWSER=0
