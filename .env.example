# ============================================================================
# 설정 적는 곳 (예시)
#
# 1) 이 파일을 복사해서 이름을 .env 로 바꾼다 (같은 폴더).
# 2) .env 에 값을 채운다. .env 는 git 에 올라가지 않는다 (.gitignore).
# 3) 서버를 다시 켠다.
#
# 배포(Render)에서는 .env 대신 Render 대시보드 > Environment 에 같은 이름으로 넣는다.
# 비어 있는 값은 안 쓴다는 뜻이다. 비워 두면 지금처럼 로컬 SQLite 로 돈다.
# ============================================================================

# ---- Supabase (공유 링크·AI 풀이 저장) -------------------------------------
# Supabase 대시보드 > Project Settings > API (또는 Data API) 에서 복사한다.
# 주소: Project URL, 예) https://abcdefghijkl.supabase.co
SUPABASE_URL=
# 서버 전용 키: "Secret keys" 의 sb_secret_... (예전 화면이면 service_role 키)
# 이 키는 DB 를 마음대로 읽고 쓸 수 있다. 채팅·코드·스크린샷에 절대 붙이지 말 것.
# anon / publishable 키가 아니다.
SUPABASE_SECRET_KEY=

# ---- AI 풀이 (OpenRouter, 유료) --------------------------------------------
# 비워 두면 AI 없이 계산 풀이만 보여 준다 (요금 0원).
# 켜려면 세 줄을 채운다 (AI_BACKEND=openrouter). 모델은 qwen/qwen3.7-flash (2026-09-27 고른 가장 싼 적합 모델)
# 생각 기능은 꺼서 부르고(요금), 같은 모델이면 가장 싼 제공사로 보낸다 (ai.py _openrouter_extra)
SAJU_AI_BACKEND=
OPENROUTER_API_KEY=
SAJU_OPENROUTER_MODEL=
# 한 시간에 부르는 AI 상한 (요금 보호). OpenRouter 기본 300
SAJU_AI_PER_HOUR=

# ---- 상담 채팅 --------------------------------------------------------------
# auto(기본): 이 컴퓨터에서 접속할 때만 / 1: 어디서나 / 0: 막음
SAJU_CHAT=
# 한 사람당 하루 질문 수. 기본 5 (IP·쿠키·결과·사주 중 하나라도 다 쓰면 막음, 이 컴퓨터에서는 세지 않는다)
SAJU_CHAT_PER_DAY=
# 모두 합쳐 하루 질문 상한. 기본 300
SAJU_CHAT_GLOBAL_PER_DAY=

# ---- 배포 주소 --------------------------------------------------------------
# 다른 사이트에서 온 요청은 막는다. 주소가 여러 개(자체 도메인 등)면 쉼표로 적는다. 예) saju.example.com
SAJU_ORIGINS=
